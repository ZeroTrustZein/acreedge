# AcreEdge Environment Configuration
ACREEDGE_ENV=development
ACREEDGE_DEBUG=true

# Database (PostgreSQL / pgvector)
ACREEDGE_DB_HOST=localhost
ACREEDGE_DB_PORT=5432
ACREEDGE_DB_USER=postgres
ACREEDGE_DB_PASSWORD=postgres
ACREEDGE_DB_NAME=acreedge_db

# MCP Server
ACREEDGE_MCP_HOST=127.0.0.1
ACREEDGE_MCP_PORT=8440

# RAG & Embeddings
ACREEDGE_VECTOR_DIM=1536
ACREEDGE_EMBEDDING_MODEL=text-embedding-3-small
